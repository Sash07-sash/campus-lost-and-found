{
  "version": 2,
  "builds": [
    {
      "src": "campus_lost_found/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.12"
      }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "check": true
    },
    {
      "src": "/static/(.*)",
      "dest": "/$1",
      "check": true
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1",
      "check": true
    },
    {
      "src": "/media/(.*)",
      "dest": "/static/media/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "campus_lost_found/wsgi.py"
    }
  ]
}
